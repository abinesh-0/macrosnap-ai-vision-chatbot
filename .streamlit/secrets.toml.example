# Copy this file to .streamlit/secrets.toml and replace every placeholder locally.
# Never commit the populated secrets.toml file.

# Required for food-image analysis and nutrition chat.
GEMINI_API_KEY = "your_gemini_api_key_here"

# The current app reads these keys at startup, even when messaging is not used.
# Delivery requires your own configured Twilio WhatsApp sender and content template.
TWILIO_ACCOUNT_SID = "your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN = "your_twilio_auth_token_here"

# Use the sender number with country code, without the "whatsapp:" prefix.
TWILIO_WHATSAPP_FROM = "+your_twilio_whatsapp_sender_number"
TWILIO_CONTENT_SID = "your_twilio_content_sid_here"